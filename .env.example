# Required to run telegram_sales_bot.py
# Retainer payment link (2.500 EUR request) — replace the placeholder with the
# live payoneer.com request URL; Nirvana payment/renewal flows read this value.
PAYONEER_PAYMENT_URL=https://link.payoneer.com/Token?t=0004D0C2635F454381DBFC36C32BA2FE&src=pl
PAYMENT_CURRENCY=EUR
PAYMENT_AMOUNT=2500
# Gerçek insan kimliği — raporlarda ve Telegram akışında görünür (robot algısını kırar)
OWNER_LINKEDIN_URL=https://www.linkedin.com/in/fevzican-aytekin-0b5501105
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_BOT_USERNAME=YourSalesBot
# Bot ID (yalnızca TELEGRAM_BOT_TOKEN id'siz girildiyse gerekir: "123456789:AAH...").
# Token'ın ":" öncesi kısmıdır; /notifyme ve token normalizasyonu bunu kullanır.
TELEGRAM_BOT_ID=
# Ek satış botları — her satış botu ayrı flood limiti demek:
# "token1,token2" (virgülle). TELEGRAM_BOT_TOKENS adı da kabul edilir.
TELEGRAM_OTHER_BOT_TOKENS=
# Ops notifications (pipeline, sıcak lead) — ayrı bot veya private kanal; müşteri satış botundan farklı.
TELEGRAM_NOTIFY_BOT_TOKEN=
TELEGRAM_NOTIFY_CHAT_ID=
TELEGRAM_OWNER_CHAT_ID=
# Owner self-service registration: /admin KOD must equal this (set on Oracle, never commit real value)
ADMIN_CODE=change-me-set-on-oracle
# Yönetici kimlik doğrulaması (GitHub Secret → Oracle .env):
#  TELEGRAM_ADMIN_ID    : patronun Telegram id'si (deploy bunu OWNER_CHAT_ID'den yazar)
#  TELEGRAM_ADMIN_TOKEN : /notifyme TOKEN ile sohbeti yönetici olarak kaydeder
#                         ("Sistem Sahibi Taptaze Senkronize Edildi" yanıtı)
TELEGRAM_ADMIN_ID=
TELEGRAM_ADMIN_TOKEN=
# Yerel Telegram Bot API (opsiyonel, $0): dakikada-30-mesaj + 20 MB dosya sınırı kalkar.
# Boş bırakılırsa standart bulut API kullanılır (fail-safe). Örnek:
#  TELEGRAM_BOT_API_BASE_URL=http://127.0.0.1:8081
#  TELEGRAM_BOT_API_BASE_URL=http://telegram-bot-api:8081   (docker-compose)
TELEGRAM_BOT_API_BASE_URL=
# telegram-bot-api konteynerinin istediği my.telegram.org anahtarları (asla commit etme).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Institutional review-lab frame (presentation only, open-standard benchmarks)
AUDIT_LAB_NAME=DevSolve Flow Inspector
AUDIT_REPORT_PREFIX=DS
AUDIT_REPORT_YEAR=2026

# Local Ollama (no OpenAI key)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=deepseek-r1:14b
PRICE_USD=2500

PRODUCT_NAME=Your Product
PRODUCT_DESCRIPTION=One or two sentences describing what you sell and the outcome you deliver.
ICP_DESCRIPTION=Ideal customer: industry, company size, geography, and the pain you solve.

SENDER_NAME=Alex Rivera
SENDER_EMAIL=alex@yourcompany.com
SENDER_COMPANY=Your Company
SENDER_PHONE=

MIN_FIT_SCORE=60
HEADLESS=true
NAV_TIMEOUT_MS=30000
FORM_DELAY_MIN_SECONDS=5
FORM_DELAY_MAX_SECONDS=8
FORM_DELAY_FAST_MIN_SECONDS=5
FORM_DELAY_FAST_MAX_SECONDS=8
FORM_DELAY_STRICT_MIN_SECONDS=8
FORM_DELAY_STRICT_MAX_SECONDS=12
# --- Spam-minimal maximum throughput caps ------------------------------------
# Daily is a hard ceiling that never expands (knowledge.daily_cap keeps min(400, ...)).
# Hourly spread + per-provider pacing (3/h) keep the IP clean while letting the
# pipeline actually reach the 400/day ceiling in ~9-10 active hours.
DAILY_SUBMIT_LIMIT=400
HOURLY_SUBMIT_LIMIT=48
DAILY_HTTP_PROBE_LIMIT=800
HOURLY_HTTP_PROBE_LIMIT=40
CHROMIUM_BATCH=40
HTTP_PROBE_BATCH=26
MAX_PIPELINE_PROBES=40
PIPELINE_SUBMIT_SLICE=24
HOURLY_SUBMIT_FLOOR=40
# Queue / fuel tank: keep at least 500 ready hosts so discovery can never
# starve the hour, and refill hard below 150.
QUEUE_TARGET=500
QUEUE_REFILL_BELOW=150
QUEUE_MAX=2500
FUEL_TARGET=500
# GitHub feed: fresh Common Crawl + enterprise demand, pulled over raw URLs.
FEED_URL=https://api.github.com/repos/fevzican1/lead-qualification-engine/contents/feeds/ready_queue.json?ref=master
FEED_RAW_URL=https://raw.githubusercontent.com/fevzican1/lead-qualification-engine/master/feeds/ready_queue.json
FEED_GITHUB_TOKEN=
FEED_MIN_SCORE=80
SITE_TIMEOUT_SECONDS=45
NAV_TIMEOUT_MS=30000
PIPELINE_TIMEOUT_SECONDS=30
# auto_runner tek turda pipeline.py'yi bu duvar-saati sınırıyla koşar; sınır
# dolunca takılı Chromium öldürülür ve tur kapanır (hat asla saatlerce kilitlenmez).
PIPELINE_RUN_TIMEOUT_SECONDS=2400
DISCOVERY_EVERY_SECONDS=18000
DEFER_MINUTES=20
HTTP_RESERVE_FOR_PIPELINE=20
PROOF_CARD_DELAY_SECONDS=45
MONTHLY_SALES_TARGET=100
LEAD_BATCH_SIZE=15
AUTO_RUNNER_SLEEP_SECONDS=21600
PLAYWRIGHT_BROWSERS_PATH=
INGEST_API_TOKEN=change-me-to-a-long-random-token
INGEST_API_PORT=8787

# Musterinin gordugu gorunen ad - bot kelimesi ASLA gecmemeli (Telegram username -bot ile biter; gorunen ad degistirilir).
BOT_DISPLAY_NAME=DevSolve Teknik Ekip
BOT_PUBLIC_DESCRIPTION=DevSolve - teknik satis ve operasyon ekibi. Entegrasyon ve otomasyon kapsami icin yazin.

# --- Web Live Chat Engine (MUSTERI HATTI — Telegram musteriye KAPALI) ---------
# Form dolduran musteri t.me yerine bu adrese yonlendirilir: FLOOD_WAIT/ban/hiz
# limiti musteri mimarisinden tamamen cikar (Oracle Always Free, $0).
# Ornek: WEBCHAT_PUBLIC_URL=http://<oracle-vm-public-ip>
#        WEBCHAT_PUBLIC_URL=https://chat.sirketiniz.com   (nginx 80/443 -> 8765)
WEBCHAT_PUBLIC_URL=
# Web chat servisi bind portu (nginx arkasinda 127.0.0.1'de dinler).
WEBCHAT_PORT=8765
WEBCHAT_BIND_HOST=127.0.0.1
# Telegram SADECE pasif admin/operator hatti: VIP lead, odeme istegi, /status.
# Operator sohbeti (bildirimler buraya duser; flood_gate ile hiz sinirli):
TELEGRAM_OWNER_CHAT_ID=8465614326
