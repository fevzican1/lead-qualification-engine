[Unit]
Description=Nirvana form lane — auto_runner (refill + qualify + submit loop, Oracle VM)
Documentation=file:///opt/devsolve/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=devsolve
WorkingDirectory=/opt/devsolve
# PYTHONUNBUFFERED: journalctl'e anında yazılsın. Tamponlu stdout yüzünden
# "son log 18:20" görünüp hattın canlı olup olmadığı anlaşılmıyordu.
Environment=PYTHONUNBUFFERED=1
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/devsolve/.playwright
ExecStart=/opt/devsolve/.venv/bin/python /opt/devsolve/auto_runner.py
Restart=always
RestartSec=30
# Güvenlik ağı: takılı bir tur (ağ/Chromium) hattı saatlerce kilitleyemesin.
# Normal tur 20-25 sn; 4 saat dolduysa süreç sert yeniden başlatılır.
RuntimeMaxSec=4h
Nice=5

[Install]
WantedBy=multi-user.target