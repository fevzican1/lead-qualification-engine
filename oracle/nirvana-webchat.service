[Unit]
Description=Nirvana Web Live Chat Engine (self-healing, WatchdogSec, $0)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
WorkingDirectory=/opt/devsolve
ExecStart=/opt/devsolve/.venv/bin/python /opt/devsolve/webchat_server.py
Restart=always
RestartSec=1
WatchdogSec=30s
KillSignal=SIGTERM
TimeoutStopSec=15
Environment=WEBCHAT_BIND_HOST=127.0.0.1
Environment=WEBCHAT_PORT=8765
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/devsolve/.playwright
# 6-madde uretim korkuluklari (Ampere Always Free: 4 OCPU / 24 GB):
# dusuk-gecikme hatti thread tavani + bellek sizintisi/kilitlenme korumasi.
Environment=LLM_MAX_CONCURRENCY=4
Environment=WEBCHAT_MAX_CONCURRENCY=4
MemoryHigh=2G
MemoryMax=3G
TasksMax=64
LimitNOFILE=4096
# WATCHDOG=1 sinyali 30 sn gelmezse systemd SIGABRT ile oldurup 1 sn icinde
# tertemiz bellekle yeniden baslatir. Oturumlar diske senkron (veri kaybi yok).
# Onunde nginx reverse-proxy (80/443 -> 127.0.0.1:8765).
# 1 DAKIKA KURALI disari bagimli degil: ic nabiz 15 sn, systemd tavan 30 sn.
# OOM kilidi: bellek 3 GB'i gecerse systemd temiz restart (kilitlenme yok).

[Install]
WantedBy=multi-user.target
