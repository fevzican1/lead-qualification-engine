[Unit]
Description=Nirvana Lane AN — local_fuel: iç kaynaklı sınırsız yakıt (Tranco/CDX/tohum -> hot_fuel.db)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/devsolve
EnvironmentFile=-/opt/devsolve/.env
# Liste servislerinden domain toplar ve hot_fuel rezervuarına yazar.
# HEDEF SİTEYE istek atılmaz (yalnızca tranco-list.eu / index.commoncrawl.org /
# crt.sh) -> Oracle IP'si hedef WAF'lara hiç görünmez. Günlük GET bütçesi +
# jitter + UA rotasyonu + circuit breaker nirvana/protection.py'den miras alınır.
ExecStart=/opt/devsolve/.venv/bin/python -m nirvana.runner local_fuel
Nice=15
IOSchedulingClass=idle
CPUQuota=50%
MemoryMax=768M
TimeoutStartSec=900
