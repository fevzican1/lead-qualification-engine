[Unit]
Description=Nirvana dispatch hub (Oracle -> GitHub API; 1dk tick, matris ritimli)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/devsolve
ExecStart=/opt/devsolve/.venv/bin/python /opt/devsolve/oracle/dispatch_hub.py
TimeoutStartSec=90
CPUQuota=5%
MemoryMax=256M
