"""Pact fixtures for consumer-driven contract testing.

Provides a session-scoped Pact builder that starts a mock provider service
and tears it down after the test session. Each consumer test defines expected
request/response interactions against a mock server, producing a Pact JSON
file that can be published to a Pact Broker for provider verification.

Pact-python v4 API:
  pact = Pact(consumer, provider)
  server = pact.serve()        # starts mock HTTP server
  server.port                  # bound port
  pact.write_file(dir)         # writes pact JSON on teardown
"""

from __future__ import annotations

import os
from pathlib import Path
from types import SimpleNamespace
import pytest
from pact import Pact
from pact import match

PACT_DIR = Path(__file__).resolve().parent.parent.parent / "pacts"
PACT_DIR.mkdir(parents=True, exist_ok=True)

BROKER_URL = os.getenv("PACT_BROKER_URL", "")
BROKER_TOKEN = os.getenv("PACT_BROKER_TOKEN", "")


@pytest.fixture(scope="session")
def pact_builder() -> SimpleNamespace:
    """Start Pact mock service for WebchatService <-> PaymentService contract.

    Yields a SimpleNamespace with:
      - upon_receiving, given, with_request, with_body, will_respond_with (from Pact)
      - port (from PactServer, for building base URL)
      - url (from PactServer, full base URL)
    """

    pact = Pact("WebchatService", "PaymentService")
    
    # Register state handlers for the Turkish provider states BEFORE serving
    # The Pact v4 mock server requires these handlers to be registered
    # so that given() can respond to the provider states
    try:
        from pact import mock_server
        
        # Create state handlers for the Turkish provider states
        states = {
            "Odeme altyapisi aktif ve bakiye yeterli": {
                "handler": "active_payment_service",
                "response": {"status": "SUCCESS", "transaction_id": "TX-12345", "amount": 150.50, "currency": "TRY", "provider": "iyzico"},
            },
            "Odeme gecmesi mevcut ve iade edilebilir": {
                "handler": "refund_available_service",
                "response": {"status": "REFUNDED", "refund_id": "RF-67890", "original_transaction_id": "TX-998234", "amount": 150.50, "currency": "TRY"},
            }
        }
        
        # Register each state handler
        for state_desc, state_info in states.items():
            try:
                handler = pact.handle_state(state_desc)
                # Configure the handler to respond with the expected state
                handler.upon_get("state_check").will_respond_with(status=200)
            except Exception as e:
                print(f"Warning: Could not register state handler for '{state_desc}': {e}")
                
    except Exception as e:
        print(f"Warning: Could not register state handlers: {e}")
    
    with pact.serve() as server:
        try:
            yield SimpleNamespace(
                pact=pact,
                server=server,
                upon_receiving=pact.upon_receiving,
                port=server.port,
                url=server.url,
            )
        finally:
            pact.write_file(str(PACT_DIR))


@pytest.fixture
def pact_dir() -> Path:
    return PACT_DIR


__all__ = ["pact_builder", "pact_dir", "Pact", "match"]